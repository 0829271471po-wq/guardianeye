# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
TELEGRAM_BOT_TOKEN=ใส่token
TELEGRAM_CHAT_ID=ใส่chatid

# แหล่งภาพกล้อง (เลือกบรรทัดเดียว ไม่ต้องใส่เครื่องหมายคำพูด)
#   webcam ของคอม           → CAMERA_SOURCE=0
#   ESP32-CAM               → CAMERA_SOURCE=http://<IP ของ ESP32>:81/stream
#   iPhone (แอป DroidCam)   → CAMERA_SOURCE=http://<IP มือถือ>:4747/video
# ถ้าไม่ใส่บรรทัดนี้ ระบบจะใช้ webcam (0)
CAMERA_SOURCE=0
